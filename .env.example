# Public URL teachers and students open (SSO callback + CORS)
PUBLIC_URL=https://ielts.eduportal.az
HTTP_BIND=127.0.0.1:8091

# Own database
IELTS_DB_USER=eduielts
IELTS_DB_PASSWORD=change-me
IELTS_DB_NAME=eduielts

# EduPortal database, SELECT-only role (docs/sql/eduportal-readonly-role.sql)
# same server (docker network):  postgresql://eduielts_readonly:PASS@db:5432/eduportal
# other server:                  postgresql://eduielts_readonly:PASS@10.0.0.5:5432/eduportal?sslmode=require
EDUPORTAL_DATABASE_URL=postgresql://eduielts_readonly:change-me@db:5432/eduportal
EDUPORTAL_NETWORK=eduportal_eduportal-net
EDUPORTAL_NETWORK_EXTERNAL=true

# Secrets
IELTS_JWT_SECRET=generate-with-openssl-rand-base64-48

# EduPortal single sign-on: the ONLY way to sign in (docs/EDUPORTAL_SSO.md). Required.
# Public key only; the private key stays on the EduPortal server. One line, \n for newlines.
EDUPORTAL_SSO_AUTHORIZE_URL=https://eduportal.az/az/sso/eduielts
EDUPORTAL_SSO_PUBLIC_KEY=
EDUPORTAL_SSO_CLIENT_ID=eduielts
COOKIE_SECURE=true

# IELTS Test Packages (docs/IELTS_PACKAGE_FORMAT.md)
MAX_PACKAGE_MB=120
# Hosts package media may be downloaded from when given as https URLs (comma separated)
ASSET_FETCH_ALLOWED_HOSTS=
# ielts-content 1.0.0 packages: https base URL their assets[].storageKey is relative to
ASSET_STORAGE_BASE_URL=
