# EduPortal IELTS API ---------------------------------------------------------
NODE_ENV=development
PORT=4002

# Own database (read/write, migrated by this repository)
DATABASE_URL=postgresql://eduielts:eduielts@localhost:5432/ielts_dev

# EduPortal database through the SELECT-only role (docs/sql/eduportal-readonly-role.sql)
EDUPORTAL_DATABASE_URL=postgresql://eduielts_readonly:CHANGE_ME@localhost:5432/eduportal

# Session signing secret (min. 32 chars, random)
IELTS_JWT_SECRET=change-me-to-a-long-random-string-0123456789
SESSION_TTL_HOURS=12

# Public origin of this site (used to build the SSO callback URL)
PUBLIC_URL=http://localhost:3200
# EduPortal single sign-on: the ONLY way to sign in (docs/EDUPORTAL_SSO.md). Required.
# Local dev: run `node scripts/dev-sso-provider.js`, it prints the public key.
EDUPORTAL_SSO_AUTHORIZE_URL=http://localhost:4110/az/sso/eduielts
EDUPORTAL_SSO_PUBLIC_KEY=
EDUPORTAL_SSO_CLIENT_ID=eduielts
EDUPORTAL_SSO_ISSUER=eduportal

# Browser origin(s) of the frontend, comma separated
CORS_ORIGIN=http://localhost:3200
# Public URL prefix of this API (nginx: /api)
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=false

# Test media (audio/images) and Speaking recordings
UPLOAD_DIR=./uploads
# Largest IELTS Test Package accepted by POST /tests/import (base64 audio included)
MAX_PACKAGE_MB=120
MAX_RECORDING_MB=15
# Hosts that package assets given as https URLs may be downloaded from (comma separated)
ASSET_FETCH_ALLOWED_HOSTS=
